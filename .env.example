# Copy to .env; never commit .env. All generation defaults to synthetic mock.
VIDEO_PROVIDER=mock
OUTPUT_ROOT=./projects
MAX_RETRIES=2
OPERATION_TIMEOUT=600
POLL_INITIAL_DELAY=0.25
FFMPEG=ffmpeg
FFPROBE=ffprobe
MAX_UPLOAD_MB=50

# gflow is selected as the planned live integration, but readiness is blocked.
# No Google API key, Gemini billing or Vertex billing is used.
# VEO_MODEL is an optional display/config value; no model is silently chosen.
VEO_MODEL=
VEO_ASPECT_RATIO=9:16
VEO_RESOLUTION=720p
VEO_DURATION_SECONDS=8

# Leave blank for local SQLite. On Windows with UNC output, DB automatically
# uses LOCALAPPDATA/nextgen-local/<output-path-hash>/nextgen.db.
DATABASE_URL=

